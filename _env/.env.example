# =============================================================================
# NestJS Multi-DB API Starter - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials to version control!
# =============================================================================

LANG=UTF-8
NODE_ENV=development

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
DOMAIN=http://localhost:3000
API_KEY=your-api-key-here
PORT=7000

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=starter_db
POSTGRES_DB_USERNAME=postgres
POSTGRES_DB_PASSWORD=your-password
POSTGRES_DB_SSL=false

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
DB_URL=mongodb://localhost:27017/starter_db

# -----------------------------------------------------------------------------
# Message Queue - RabbitMQ
# -----------------------------------------------------------------------------
RABBIT_MQ_URL=amqp://guest:guest@localhost:5672

# -----------------------------------------------------------------------------
# Cache - Redis
# -----------------------------------------------------------------------------
REDIS_SERVER_HOST_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Email - SendGrid
# -----------------------------------------------------------------------------
SEND_GRID_API_KEY=SG.your-sendgrid-api-key

# -----------------------------------------------------------------------------
# SMS Provider (twilio | multitexter)
# -----------------------------------------------------------------------------
SMS_PROVIDER=twilio
MULTITEXTER_BASE_URL=https://app.multitexter.com/v2/app/sendsms
MULTITEXTER_API_KEY=your-multitexter-api-key
MULTITEXTER_SENDER_ID=YourApp

# -----------------------------------------------------------------------------
# File Storage - Cloudinary
# -----------------------------------------------------------------------------
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_API_URL=cloudinary://api-key:api-secret@cloud-name

# -----------------------------------------------------------------------------
# File Storage - AWS S3
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY=your-access-key
AWS_SECRET_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET=your-bucket-name
AWS_BUCKET_BASE_URL=https://your-cloudfront.cloudfront.net

# -----------------------------------------------------------------------------
# Payment - Flutterwave
# -----------------------------------------------------------------------------
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
USE_API_KEY=test
# Test keys
FLUTTERWAVE_TEST_PUBLIC_KEY=FLWPUBK_TEST-xxx
FLUTTERWAVE_TEST_SECRET_KEY=FLWSECK_TEST-xxx
# Live keys
FLUTTERWAVE_LIVE_PUBLIC_KEY=FLWPUBK-xxx
FLUTTERWAVE_LIVE_SECRET_KEY=FLWSECK-xxx

# -----------------------------------------------------------------------------
# Payment - Paystack
# -----------------------------------------------------------------------------
PAYSTACK_BASE_URL=https://api.paystack.co
# Test keys
PAYSTACK_TEST_PUBLIC_KEY=pk_test_xxx
PAYSTACK_TEST_SECRET_KEY=sk_test_xxx
# Live keys
PAYSTACK_LIVE_PUBLIC_KEY=pk_live_xxx
PAYSTACK_LIVE_SECRET_KEY=sk_live_xxx

# -----------------------------------------------------------------------------
# Payment - Stripe
# -----------------------------------------------------------------------------
# Test keys
STRIPE_TEST_KEY=pk_test_xxx
STRIPE_TEST_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_TEST_KEY=whsec_xxx
# Live keys
STRIPE_LIVE_KEY=pk_live_xxx
STRIPE_LIVE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_LIVE_KEY=whsec_xxx

# -----------------------------------------------------------------------------
# Payment - PayPal
# -----------------------------------------------------------------------------
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TEST_PUBLIC_KEY=your-client-id
PAYPAL_TEST_SECRET_KEY=your-secret

# -----------------------------------------------------------------------------
# Push Notifications - Pusher
# -----------------------------------------------------------------------------
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_CLUSTER=us2

# -----------------------------------------------------------------------------
# Firebase
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=your-api-key
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APPID=your-app-id
FIREBASE_MEASUREMENT_ID=G-xxx

# -----------------------------------------------------------------------------
# Admin Credentials (CHANGE IN PRODUCTION!)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourapp.com
ADMIN_PASSWORD=change-this-password

# -----------------------------------------------------------------------------
# Microservices URLs (Gateway Routing)
# -----------------------------------------------------------------------------
USER_MICROSERVICE_URL=http://localhost:7000/api/v1
WORKER_MICROSERVICE_URL=http://localhost:7010/api/v1
ADMIN_MICROSERVICE_URL=http://localhost:7001/api/v1
